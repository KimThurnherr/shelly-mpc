# mindestens 32 Zeichen, z.B. aus: openssl rand -base64 48
MCP_AUTH_TOKEN=
# Server-URI aus der Shelly-App (gleiche Seite wie der Key), z.B. shelly-00-eu.shelly.cloud
SHELLY_CLOUD_SERVER=
SHELLY_CLOUD_AUTH_KEY=
# BLU Gateway Gen3, kommagetrennt, z.B. Wohnung=http://192.0.2.10
SHELLY_GATEWAYS=
# nur falls auf dem Gateway ein Passwort gesetzt ist (Benutzer ist immer admin)
SHELLY_GATEWAY_PASSWORD=
MCP_BIND_ADDR=127.0.0.1
MCP_HOST_PORT=8430
